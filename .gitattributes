# Machine-generated tracker exports. The pre-commit hook regenerates these
# from the local chainlink/deciduous databases on every commit, so at merge
# time the branch's own copy is always the correct resolution — whichever
# side git picked would be overwritten by the next commit's fresh export
# anyway. The `keep-ours` custom driver (wired per-clone by
# scripts/install-hooks.sh: `git config merge.keep-ours.driver true`) keeps
# the current branch's version and ends the guaranteed every-PR conflict on
# these files. Note: custom drivers only run in local merges — GitHub's UI
# can't use them, so update branches locally when these conflict.
.chainlink/issues-export.json merge=keep-ours
docs/graph-data.json merge=keep-ours
docs/git-history.json merge=keep-ours

# Chainlink appends an entry on every session end, on whatever branch is
# checked out; two branches touching the changelog is the normal case, not
# a conflict. The built-in union driver keeps both sides' lines.
CHANGELOG.md merge=union
