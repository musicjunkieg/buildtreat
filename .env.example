# Project environment variables.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# This file lives in git as documentation. The real .env is gitignored.

# ── S3-compatible backup storage (chainlink + deciduous DBs) ────────
# Used by scripts/install-hooks.sh (pre-commit auto-backup) and
# scripts/restore-dbs.sh (disaster recovery).
#
# Provider-agnostic — works with any S3-compatible storage:
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:   https://s3.<region>.backblazeb2.com
#   AWS S3:         https://s3.<region>.amazonaws.com
#
# When provisioning via `new-project`, these get filled in automatically.
# When cloning an existing project, populate from your password manager.

BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto

# ── Project-specific variables ─────────────────────────────────────
# Add your project's runtime config below.
#
# Examples:
# DATABASE_URL=postgres://user:pass@localhost/dbname
# API_KEY=
# RUST_LOG=info
