{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buildtreat",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{ "binding": "OAUTH_SESSIONS", "id": "TBD_CREATE_WITH_wrangler_kv_namespace_create" },
		{ "binding": "OAUTH_STATES", "id": "TBD_CREATE_WITH_wrangler_kv_namespace_create" },
		{ "binding": "PROFILE_CACHE", "id": "TBD_CREATE_WITH_wrangler_kv_namespace_create" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buildtreat",
			"database_id": "TBD_CREATE_WITH_wrangler_d1_create",
			"migrations_dir": "migrations"
		}
	]
	// Secrets (wrangler secret put): COOKIE_SECRET, CLIENT_ASSERTION_KEY
	// Vars set at deploy time: ORIGIN (the public https URL)
}
